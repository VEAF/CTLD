*.iml
.idea/encodings.xml
*.xml

# CTLD.lua is intentionally tracked — available at repo root for DCS missions.
# Do NOT add it to .gitignore.

# ── Local-only recette scratch files (never commit) ──────────────────────────
# recette/local/ no longer exists in the repo.
# Diagnostic probes are in recette/dev/diag/ (tracked).
# If you create personal scratch scripts, put them here and they will be ignored:
recette/scratch/

# ── Backup files generated by sed/perl in-place edits ────────────────────────
*.bak

# ── mkdocs build output (generated locally; site is published via CI to gh-pages)
site/

# ── IDE / editor local config (machine-specific paths) ───────────────────────
.vscode/settings.json
.claude/settings.local.json

# ── dcs-bridge local client config (holds the machine-local API key) ─────────
dcs-client.yaml

# ── dcs-bridge local venv (installed by tools/dcs-bridge/install.ps1) ────────
tools/dcs-bridge/venv/